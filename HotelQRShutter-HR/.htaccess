<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect to login if not authenticated for admin area
    RewriteCond %{REQUEST_URI} ^/hotel_qr_system/admin [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !/hotel_qr_system/login\.php [NC]
    RewriteCond %{REQUEST_URI} !/hotel_qr_system/logout\.php [NC]
    RewriteRule ^(.*)$ /hotel_qr_system/login.php [L,R]
    
    # Prevent directory listing
    Options -Indexes
    
    # Security headers
    <IfModule mod_headers.c>
        Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    # Updated CSP policy:
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.rawgit.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data: https:; font-src 'self' https://cdnjs.cloudflare.com; connect-src 'self'"
    </IfModule>
</IfModule>
<Files "orders_stream.php">
    Satisfy Any
    Allow from all
</Files>
# Prevent access to sensitive files
<FilesMatch "\.(env|log|htaccess|htpasswd|ini|phps|fla|psd|log|sh|sqlite|db)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# PHP settings
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value memory_limit 128M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value session.cookie_httponly 1
    php_value session.cookie_secure 1
    php_value session.use_strict_mode 1
</IfModule>